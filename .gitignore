# Кэш Python (создается автоматически при запуске скриптов)
__pycache__/
*.py[cod]
*$py.class

# Файлы с данными (чтобы ваши личные задачи не улетали в репозиторий)
todo.json
*.json

# Окружение и пакетные менеджеры (если используете uv, venv или poetry)
.venv/
venv/
ENV/
.uv/

# Локальные настройки редактора (VS Code)
.vscode/
